+bool QmmpAudioEngine::finishCurrentAfter(qint64 milliseconds)
+{
+    QMutexLocker lock(mutex());
+    if (!m_decoder || m_decoders.isEmpty()) return false;
+    m_transitionRate = m_decoder->audioParameters().sampleRate();
+    m_transitionFrames = qBound<qint64>(qint64(0), milliseconds, qint64(12000)) * m_transitionRate.load() / 1000;
+    return true;
+}
+qint64 QmmpAudioEngine::transitionRemaining() const
+{
+    const auto frames = m_transitionFrames.load();
+    return frames < 0 ? -1 : frames * 1000 / qMax(1U,m_transitionRate.load());
+}
