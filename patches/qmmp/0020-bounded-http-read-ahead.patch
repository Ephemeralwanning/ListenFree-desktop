+bool HttpStreamReader::waitForBufferSpace(size_t incoming)
+{
+    // Bound unread compressed audio instead of downloading up to 150 MB into RAM.
+    // Keep the configured prebuffer and the existing seek/lookback caches.
+    const size_t highWater = qMax<size_t>(4 * 1024 * 1024, m_prebufferSize + incoming);
+    while(!m_stream.aborted && !m_cancelled.load() && m_stream.buf_fill + incoming > highWater)
+        m_dataArrived.wait(&m_mutex);
+    return !m_stream.aborted && !m_cancelled.load();
+}
