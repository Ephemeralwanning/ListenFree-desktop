+        double energy = 0;
+        for(size_t i = start; i < start + window; ++i) energy += m_buffer[i] * m_buffer[i];
+        peakRms = std::max(peakRms, std::sqrt(energy / window));
+    }
+    const double threshold = std::clamp(peakRms * 0.12, 0.001, 0.012);
+    size_t keep = m_buffer_at;
+    const size_t minimum = size_t(sampleRate()) * channels() / 4;
+    while(keep > minimum + window)
+    {
+        double energy = 0;
+        for(size_t i = keep - window; i < keep; ++i) energy += m_buffer[i] * m_buffer[i];
+        if(std::sqrt(energy / window) > threshold) break;
+        keep -= window;
+    }
+    if(m_buffer_at - keep >= size_t(sampleRate()) * channels() * 3 / 10)
+        m_buffer_at = keep;
+    m_mix_total = m_buffer_at;
+}
+
+void CrossfadePlugin::mix(float *cur_buf, float *prev_buf, size_t samples)
+{
+    const size_t channelCount = std::max(1, channels());
+    const double frames = std::max<size_t>(1, m_mix_total / channelCount - 1);
+    const size_t consumed = m_mix_total - m_buffer_at;
+    for(size_t i = 0; i < samples; i += channelCount)
+    {
+        const double progress = std::min(1.0, double((consumed + i) / channelCount) / frames);
+        const double angle = progress * 1.5707963267948966;
+        const double incoming = std::sin(angle), outgoing = std::cos(angle);
+        for(size_t channel = 0; channel < channelCount && i + channel < samples; ++channel)
+        {
+            const auto at = i + channel;
+            cur_buf[at] = qBound(-1.0f, float(cur_buf[at] * incoming + prev_buf[at] * outgoing), 1.0f);
+        }
     }
