+void SoundCore::cancelQueuedSource()
+{
+    Q_D(SoundCore);
+    // Deliver an already completed handoff before cancelling the next slot.
+    qApp->sendPostedEvents(this, 0);
+    qDeleteAll(d->sources);
+    d->sources.clear();
+    if(auto *engine = qobject_cast<QmmpAudioEngine *>(d->engine))
+        engine->cancelQueuedDecoders();
+    d->nextState = SoundCorePrivate::NO_ENGINE;
+}
