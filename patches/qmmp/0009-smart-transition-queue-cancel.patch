+void QmmpAudioEngine::cancelQueuedDecoders()
+{
+    QMutexLocker lock(mutex());
+    m_transitionFrames = -1;
+    m_next = false;
+    while(!m_decoders.isEmpty())
+    {
+        Decoder *decoder = m_decoders.dequeue();
+        m_inputs.take(decoder)->deleteLater();
+        delete decoder;
+    }
+}
