+    // A local file can begin with a large ID3 cover tag. A small peek then
+    // guesses from the extension, which may be wrong. Let libavformat probe
+    // through our AVIO callbacks instead of forcing that low-confidence guess.
+    if(!qobject_cast<QFile *>(input()))
+    {
+        AVProbeData pd = {};
+        uint8_t buf[PROBE_BUFFER_SIZE + AVPROBE_PADDING_SIZE] = {};
+        const QByteArray filename = m_path.toLocal8Bit();
+        pd.filename = filename.constData();
+        pd.buf_size = input()->peek((char*)buf, sizeof(buf) - AVPROBE_PADDING_SIZE);
+        pd.buf = buf;
+        if(pd.buf_size < PROBE_BUFFER_SIZE)
+        {
+            qCWarning(plugin, "too small buffer size: %d bytes", pd.buf_size);
+            return false;
+        }
+        fmt = av_probe_input_format(&pd, 1);
+        if(!fmt)
+        {
+            qCWarning(plugin, "unsupported format");
+            return false;
+        }
+    }
 
