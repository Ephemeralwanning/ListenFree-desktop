+
+/* The same upstream coefficient equations, with octave centers kept stable
+ * across sample rates. Frequencies at/above Nyquist contribute no output. */
+sIIRCoefficients* get_iso_coeffs(unsigned int sfreq)
+{
+  static sIIRCoefficients coeffs[10];
+  for(int i = 0; i < 10; ++i) {
+    coeffs[i].alpha = coeffs[i].beta = coeffs[i].gamma = 0;
+    if(!sfreq || band_f010[i] >= sfreq * 0.5) continue;
+    double f1, f2, x0;
+    find_f1_and_f2(band_f010[i], 1.0, &f1, &f2);
+    const double tf0 = 2.0 * M_PI * band_f010[i] / sfreq;
+    const double tf1 = 2.0 * M_PI * f1 / sfreq;
+    if(find_root(BETA2(tf0, tf1), BETA1(tf0, tf1), BETA0(tf0, tf1), &x0) == 0) {
+      coeffs[i].beta = 2.0 * x0;
+      coeffs[i].alpha = 2.0 * ALPHA(x0);
+      coeffs[i].gamma = 2.0 * GAMMA(x0, tf0);
+    }
+  }
+  return coeffs;
 }
 
